   ],
   "source": [
    "num = int(input(\"Enter a number: \"))\n",
    "temp = num\n",
    "\n",
    "print(f\"Prime factors of {num} are:\")\n",
    "\n",
    "# Loop from 2 up to the number\n",
    "for i in range(2, temp + 1):\n",
    "  # Keep dividing by 'i' as long as it evenly divides 'temp'\n",
    "  while temp % i == 0:\n",
    "    print(i, end=\" \")\n",
    "    temp = temp // i"
   ]
