      "* * * * * *\n"
     ]
    }
   ],
   "source": [
    "n = int(input(\"Enter Number of rows in the pattern\"))\n",
    "\n",
    "for i in range(1, n + 1):\n",
    "    # Print leading spaces for alignment\n",
    "    spaces = \" \" * (n - i)\n",
    "    # Join stars with a space in between for each row\n",
    "    stars = \" \".join([\"*\"] * i)\n",
    "    print(spaces + stars)"
   ]
