   ],
   "source": [
    "n = int(input(\"Enter a number: \"))\n",
    "a = 0\n",
    "for i in range(1, n + 1):\n",
    "  if n % i == 0:\n",
    "    a += 1 \n",
    "      \n",
    "if a == 2:\n",
    "  print(f\"{n} is a Prime Number.\")\n",
    "else:\n",
    "  print(f\"{n} is not a Prime Number.\")"
   ]
