   "source": [
    "num = int(input(\"Enter a number: \"))\n",
    "temp = abs(num)\n",
    "digit_sum = 0\n",
    "while temp > 0:\n",
    "  digit = temp % 10 \n",
    "  digit_sum += digit  \n",
    "  temp = temp// 10 \n",
    "print(f\"The sum of the digits of {num} is: {digit_sum}\")"
   ]
