   "source": [
    "num=int(input(\"Enter a number to check if it is palamdrone\"))\n",
    "temp = num\n",
    "rev=0\n",
    "while temp>0:\n",
    "    a= temp%10\n",
    "    rev= rev*10+a\n",
    "    temp= temp//10\n",
    "if num== rev:\n",
    "    print(\"Number is palandrome\")\n",
    "else:\n",
    "    print(\"Number is not palandrome\")\n"
   ]
