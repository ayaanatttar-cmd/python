   "source": [
    "num =int(input(\"Enter a number to reverse it\"))\n",
    "temp= num\n",
    "rev=0\n",
    "while temp >0:\n",
    "    a=temp%10\n",
    "    rev= rev*10+a\n",
    "    temp= temp//10\n",
    "print(\"Reversed number:\", rev)\n",
    "     "
   ]
